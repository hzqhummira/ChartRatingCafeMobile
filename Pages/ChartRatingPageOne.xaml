<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="ChartRatingCafe.Pages.ChartRatingPageOne"
             BackgroundColor="#E0E0E0">

    <ContentPage.Resources>
        <Style x:Key="TitleLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="{OnIdiom Phone=18, Tablet=24, Desktop=30}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SubTitleLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=18, Desktop=22}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="PickerStyle" TargetType="Picker">
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="WidthRequest" Value="{OnIdiom Phone=200, Tablet=250, Desktop=300}" />
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="TextColor" Value="Black" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Image Source="wallpaper.jpg"
               Aspect="AspectFill"
               IsVisible="True"
               Opacity="0.3" />

        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
              ColumnDefinitions="Auto"
              VerticalOptions="Center"
              HorizontalOptions="Center"
              Padding="25"
              Margin="20">

            <Label Text="Data Penilaian Kafeteria"
                   Style="{StaticResource TitleLabelStyle}"
                   Grid.Row="0"/>

            <Label Text="Pilih Kafeteria:"
                   Style="{StaticResource SubTitleLabelStyle}"
                   Grid.Row="1"/>

            <Picker x:Name="CafePicker"
                    Title="Choose a Cafe"
                    SelectedIndexChanged="OnCafeSelected"
                    Style="{StaticResource PickerStyle}"
                    Grid.Row="2"/>

            <Label x:Name="CafeNameLabel"
                   FontSize="{OnIdiom Phone=16, Tablet=20, Desktop=24}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="Black"
                   Margin="0,10,0,10"
                   Grid.Row="3"/>

            <microcharts:ChartView x:Name="CafeChartView"
                                   HeightRequest="{OnIdiom Phone=350, Tablet=450, Desktop=550}"
                                   WidthRequest="{OnIdiom Phone=350, Tablet=450, Desktop=550}"
                                   VerticalOptions="CenterAndExpand"
                                   HorizontalOptions="CenterAndExpand"
                                   Margin="0,20,0,0"
                                   Grid.Row="4"/>

            <!-- Add a Button for showing comments -->
            <Button Text="Show Comments"
                    Clicked="OnShowCommentsButtonClicked"
                    Grid.Row="5"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,20,0,0"/>
        </Grid>

        <!-- Popup Layer (Initially Hidden) -->
        <Grid x:Name="CommentsPopup"
              BackgroundColor="White"
              Padding="20"
              VerticalOptions="Center"
              HorizontalOptions="FillAndExpand"
              IsVisible="False"  
            Margin="20"
              Opacity="0.95">
            <!-- Slight transparency for the popup -->

            <!-- Popup Content -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Comments Label -->
            <Label x:Name="CommentsLabel"
                   FontSize="16"
                   TextColor="Black"
                   Grid.Row="0"
                   VerticalOptions="CenterAndExpand"
                   HorizontalOptions="CenterAndExpand"
                   Text="Here are the comments..." />

            <!-- Close Button -->
            <Button Text="Close"
                    Grid.Row="1"
                    HorizontalOptions="Center"
                    Clicked="OnClosePopupButtonClicked"
                    Margin="10,20,10,0"/>
        </Grid>
    </Grid>
</ContentPage>
